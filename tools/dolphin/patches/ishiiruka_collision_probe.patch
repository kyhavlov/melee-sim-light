+		DumpProbeVec(out, "a_offset_bits", hurt + 0x04);
+		DumpProbeVec(out, "b_offset_bits", hurt + 0x10);
+		out << ",\"scale_bits\":" << ReadProbeU32(hurt + 0x1C);
+		out << ",\"bone_ptr\":" << ReadProbeU32(hurt + 0x20);
+		out << ",\"flags\":" << static_cast<u32>(ReadProbeU8(hurt + 0x24));
+		DumpProbeVec(out, "a_pos_bits", hurt + 0x28);
+		DumpProbeVec(out, "b_pos_bits", hurt + 0x34);
+		out << ",\"bone_idx\":" << ReadProbeU32(hurt + 0x40);
+		out << ",\"height\":" << ReadProbeU32(hurt + 0x44);
+		out << ",\"is_grabbable\":" << static_cast<u32>(ReadProbeU8(hurt + 0x48));
