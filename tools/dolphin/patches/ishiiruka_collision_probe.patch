+u32 ReadProbeU32(u32 addr)
+{
+	if (addr == 0)
+		return 0;
+	return Memory::Read_U32(addr);
+}
+
+u8 ReadProbeU8(u32 addr)
+{
+	if (addr == 0)
+		return 0;
+	return Memory::Read_U8(addr);
+}
+
+void DumpProbeVec(std::ofstream& out, const char* name, u32 addr)
+{
+	out << ",\"" << name << "\":[";
+	out << ReadProbeU32(addr + 0x0) << "," << ReadProbeU32(addr + 0x4) << ","
+	    << ReadProbeU32(addr + 0x8) << "]";
+}
+
+void DumpProbeMtx34(std::ofstream& out, const char* name, u32 addr)
+{
+	out << ",\"" << name << "\":[";
+	for (u32 i = 0; i < 12; i++)
+	{
+		if (i)
+			out << ",";
+		out << ReadProbeU32(addr + i * 4);
+	}
+	out << "]";
+}
+
+void DumpProbeJObj(std::ofstream& out, const char* name, u32 jobj)
+{
+	out << ",\"" << name << "\":{";
+	out << "\"ptr\":" << jobj;
+	if (jobj != 0)
+	{
+		out << ",\"parent\":" << ReadProbeU32(jobj + 0x0C);
+		out << ",\"child\":" << ReadProbeU32(jobj + 0x10);
+		out << ",\"flags\":" << ReadProbeU32(jobj + 0x14);
+		DumpProbeVec(out, "rotate_xyz_bits", jobj + 0x1C);
+		out << ",\"rotate_w_bits\":" << ReadProbeU32(jobj + 0x28);
+		DumpProbeVec(out, "scale_bits", jobj + 0x2C);
+		DumpProbeVec(out, "translate_bits", jobj + 0x38);
+		DumpProbeMtx34(out, "mtx_bits", jobj + 0x44);
+		const u32 robj = ReadProbeU32(jobj + 0x80);
+		out << ",\"robj\":" << robj;
+		if (robj != 0)
+		{
+			out << ",\"robj_flags\":" << ReadProbeU32(robj + 0x04);
+			out << ",\"robj_u0\":" << ReadProbeU32(robj + 0x08);
+			out << ",\"robj_u4\":" << ReadProbeU32(robj + 0x0C);
+			out << ",\"robj_next\":" << ReadProbeU32(robj + 0x00);
+		}
+	}
+	out << "}";
+}
