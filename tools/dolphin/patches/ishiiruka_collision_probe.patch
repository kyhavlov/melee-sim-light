+void MaybeCaptureCollisionProbe(u32 pc)
+{
+	static bool initialized = false;
+	static bool enabled = false;
+	static std::ofstream out;
+	if (!initialized)
+	{
+		initialized = true;
+		const char* path = std::getenv("MSL_COLLISION_PROBE_PATH");
+		if (path != nullptr && path[0] != '\0')
+		{
+			out.open(path, std::ios::out | std::ios::app);
+			enabled = out.good();
+		}
+	}
+	if (!enabled)
+		return;
+
+	if (g_collision_probe_depth > 0 && pc == g_collision_probe_stack[g_collision_probe_depth - 1].lr)
+	{
+		const CollisionProbeCall call = g_collision_probe_stack[g_collision_probe_depth - 1];
+		g_collision_probe_depth--;
+		const char* fn = call.fn_pc == MSL_FTCOLL_80076ED8 ? "ftColl_80076ED8"
+		                 : call.fn_pc == MSL_LBCOLL_8000805C ? "lbColl_8000805C"
+		                                                     : "lbColl_80006E58";
+		out << "{\"pc\":" << pc << ",\"phase\":\"return\",\"fn\":\"" << fn << "\",\"frame\":"
+		    << static_cast<s32>(ReadProbeU32(MSL_FRAME_INDEX_PTR));
+		out << ",\"lr\":" << call.lr;
+		out << ",\"return_r3\":" << PowerPC::ppcState.gpr[3];
+		if (call.fn_pc == MSL_FTCOLL_80076ED8)
+		{
+			DumpProbeHitCapsule(out, "hit", call.arg4);
+			DumpProbeHurtCapsule(out, "hurt", call.arg6);
+		}
+		else if (call.fn_pc == MSL_LBCOLL_8000805C)
+		{
+			DumpProbeHitCapsule(out, "hit", call.arg3);
+			DumpProbeHurtCapsule(out, "hurt", call.arg4);
+		}
+		else
+		{
+			DumpProbeVec(out, "hit_closest_arg4_bits", call.arg7);
+			DumpProbeVec(out, "hurt_closest_arg5_bits", call.arg8);
+			DumpProbeVec(out, "hurt_coll_pos_arg7_bits", call.arg10);
+			out << ",\"coll_distance_ptr\":" << call.stack_arg8;
+			if (call.stack_arg8 != 0)
+				out << ",\"coll_distance_arg8_bits\":" << ReadProbeU32(call.stack_arg8);
+		}
+		out << "}\n";
+	}
+
+	if (pc != MSL_FTCOLL_80076ED8 && pc != MSL_LBCOLL_8000805C && pc != MSL_LBCOLL_80006E58)
+		return;
+
+	if (g_collision_probe_depth < sizeof(g_collision_probe_stack) / sizeof(g_collision_probe_stack[0]))
+	{
+		CollisionProbeCall& call = g_collision_probe_stack[g_collision_probe_depth++];
+		call.fn_pc = pc;
+		call.lr = LR;
+		call.arg3 = PowerPC::ppcState.gpr[3];
+		call.arg4 = PowerPC::ppcState.gpr[4];
+		call.arg5 = PowerPC::ppcState.gpr[5];
+		call.arg6 = PowerPC::ppcState.gpr[6];
+		call.arg7 = PowerPC::ppcState.gpr[7];
+		call.arg8 = PowerPC::ppcState.gpr[8];
+		call.arg9 = PowerPC::ppcState.gpr[9];
+		call.arg10 = PowerPC::ppcState.gpr[10];
+		// GALE01 EABI: lbColl_80006E58 has nine pointer args; arg8 is stack-passed after r10.
+		call.stack_arg8 = ReadProbeU32(PowerPC::ppcState.gpr[1] + 0x08);
+	}
+
+	const char* fn = pc == MSL_FTCOLL_80076ED8 ? "ftColl_80076ED8"
+	                 : pc == MSL_LBCOLL_8000805C ? "lbColl_8000805C"
+	                                             : "lbColl_80006E58";
+	out << "{\"pc\":" << pc << ",\"phase\":\"entry\",\"fn\":\"" << fn << "\",\"frame\":"
+	    << static_cast<s32>(ReadProbeU32(MSL_FRAME_INDEX_PTR));
+	out << ",\"lr\":" << LR;
+	out << ",\"gpr\":[";
+	for (u32 i = 3; i <= 10; i++)
+	{
+		if (i != 3)
+			out << ",";
+		out << PowerPC::ppcState.gpr[i];
+	}
+	out << "]";
+	out << ",\"fpr_bits\":[" << PowerPC::ppcState.ps[1][0] << "," << PowerPC::ppcState.ps[2][0]
+	    << "," << PowerPC::ppcState.ps[3][0] << "]";
+
+	if (pc == MSL_FTCOLL_80076ED8)
+	{
+		out << ",\"attacker_fp\":" << PowerPC::ppcState.gpr[3];
+		out << ",\"defender_fp\":" << PowerPC::ppcState.gpr[5];
+		DumpProbeFighter(out, "attacker_fighter", PowerPC::ppcState.gpr[3]);
+		DumpProbeFighter(out, "defender_fighter", PowerPC::ppcState.gpr[5]);
+		DumpProbeHitCapsule(out, "hit", PowerPC::ppcState.gpr[4]);
+		DumpProbeHurtCapsule(out, "hurt", PowerPC::ppcState.gpr[6]);
+	}
+	else if (pc == MSL_LBCOLL_8000805C)
+	{
+		out << ",\"arg3_var_r22\":" << PowerPC::ppcState.gpr[6];
+		out << ",\"matrix_ptr\":" << PowerPC::ppcState.gpr[5];
+		if (PowerPC::ppcState.gpr[5] != 0)
+			DumpProbeMtx34(out, "matrix_bits", PowerPC::ppcState.gpr[5]);
+		DumpProbeHitCapsule(out, "hit", PowerPC::ppcState.gpr[3]);
+		DumpProbeHurtCapsule(out, "hurt", PowerPC::ppcState.gpr[4]);
+	}
+	else
+	{
+		DumpProbeVec(out, "hit_x58_arg0_bits", PowerPC::ppcState.gpr[3]);
+		DumpProbeVec(out, "hit_x4c_arg1_bits", PowerPC::ppcState.gpr[4]);
+		DumpProbeVec(out, "hurt_a_arg2_bits", PowerPC::ppcState.gpr[5]);
+		DumpProbeVec(out, "hurt_b_arg3_bits", PowerPC::ppcState.gpr[6]);
+		out << ",\"matrix_ptr\":" << PowerPC::ppcState.gpr[9];
+		if (PowerPC::ppcState.gpr[9] != 0)
+			DumpProbeMtx34(out, "matrix_bits", PowerPC::ppcState.gpr[9]);
+	}
+	out << "}\n";
+}
