+void DumpProbeHitCapsule(std::ofstream& out, const char* name, u32 hit)
+{
+	out << ",\"" << name << "\":{";
+	out << "\"ptr\":" << hit;
+	if (hit != 0)
+	{
+		out << ",\"state\":" << ReadProbeU32(hit + 0x00);
+		out << ",\"group\":" << ReadProbeU32(hit + 0x04);
+		out << ",\"damage_int\":" << ReadProbeU32(hit + 0x08);
+		out << ",\"damage_bits\":" << ReadProbeU32(hit + 0x0C);
+		DumpProbeVec(out, "offset_bits", hit + 0x10);
+		out << ",\"scale_bits\":" << ReadProbeU32(hit + 0x1C);
+		out << ",\"angle\":" << ReadProbeU32(hit + 0x20);
+		out << ",\"element\":" << ReadProbeU32(hit + 0x30);
+		out << ",\"flags\":[";
+		for (u32 i = 0; i < 8; i++)
+		{
+			if (i)
+				out << ",";
+			out << static_cast<u32>(ReadProbeU8(hit + 0x40 + i));
+		}
+		out << "]";
+		out << ",\"bone_ptr\":" << ReadProbeU32(hit + 0x48);
+		DumpProbeVec(out, "x4c_bits", hit + 0x4C);
+		DumpProbeVec(out, "x58_bits", hit + 0x58);
+		DumpProbeVec(out, "hurt_coll_pos_bits", hit + 0x64);
+		out << ",\"coll_distance_bits\":" << ReadProbeU32(hit + 0x70);
+	}
+	out << "}";
+}
