+// Motion-state tables initialize this union as one PPC source word. Decode
+// its authored fields numerically so bitfield allocation order is host-neutral.
+// refs/melee/src/melee/ft/{types.h,ftmotionstates.c}
+static inline u8 MotionState_MoveId(const struct MotionState* state)
+{
+    return (u8) (state->_ >> 24);
+}
+
+static inline bool MotionState_Flag(const struct MotionState* state, u32 bit)
+{
+    return ((state->_ >> (23U - bit)) & 1U) != 0;
+}
