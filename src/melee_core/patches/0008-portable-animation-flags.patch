+/*
+ * Fighter_ChangeMotionState copies MotionState.x10_animCurrFlags as one u32.
+ * Decode that source word numerically so the PPC bit numbering does not depend
+ * on the host compiler's bitfield layout.
+ * refs/melee/src/melee/ft/{fighter.c,types.h}
+ */
+static inline bool Fighter_AnimFlag(const Fighter* fp, u32 bit)
+{
+    return (((u32) fp->x594_s32 >> (31U - bit)) & 1U) != 0;
+}
+
+static inline u32 Fighter_AnimBoneIndex(const Fighter* fp)
+{
+    return ((u32) fp->x594_s32 >> 6) & 7U;
+}
+
+static inline u32 Fighter_AnimSourceParts(const Fighter* fp)
+{
+    return ((u32) fp->x594_s32 >> 9) & 0x1FFFU;
+}
+
+static inline FighterKind Fighter_AnimSourceKind(const Fighter* fp)
+{
+    return (FighterKind) ((u32) fp->x594_s32 & 0x3FU);
+}
 STATIC_ASSERT(sizeof(struct Fighter) == 0x23EC);
 
