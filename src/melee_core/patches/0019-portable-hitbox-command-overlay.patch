+static inline bool ftAction_ShouldSkipUnownedHitbox(CommandInfo* cmd)
+{
+#ifdef MSL_CORE_NATIVE
+    // Source reads bit 124 of the six-word hitbox command through a packed
+    // overlay. Native CmdUnion records are widened for Subroutine/Goto
+    // pointers, so address the same fourth script word through stream stride.
+    // refs/melee/src/melee/ft/ftaction.c::ftAction_8007121C
+    // refs/melee/src/melee/lb/types.h::{CmdUnion,spawn_hitbox_skip}
+    u8* fourth_word = (u8*) &cmd->u[3];
+    return (fourth_word[3] & 0x08) != 0;
+#else
+    struct spawn_hitbox_skip* skip =
+        (struct spawn_hitbox_skip*) cmd->u;
+    return skip->xF_b4;
+#endif
+}
