+// Headless projection accessor for the exact CObj transform published by
+// Camera_8002AF68. Camera_GetTransform{Position,Interest} intentionally omit
+// the per-frame quake translation and retain their retail semantics.
+void msl_camera_get_render_transform(Vec3* position, Vec3* interest,
+                                     float* fov)
+{
+    *position = cm_80452C68.transform.position;
+    position->x += cm_80452C68.translation.x;
+    position->y += cm_80452C68.translation.y;
+    *interest = cm_80452C68.transform.interest;
+    interest->x += cm_80452C68.translation.x;
+    interest->y += cm_80452C68.translation.y;
+    *fov = cm_80452C68.transform.fov;
+}
+
+// Camera_800310B8 forces the separately maintained transform_copy CObj
+// matrix for DeadUpFall's render-owned world-position publication.
+void msl_camera_get_deadup_render_transform(Vec3* position, Vec3* interest,
+                                            float* fov)
+{
+    *position = cm_80452C68.transform_copy.position;
+    position->x += cm_80452C68.translation.x;
+    position->y += cm_80452C68.translation.y;
+    *interest = cm_80452C68.transform_copy.interest;
+    interest->x += cm_80452C68.translation.x;
+    interest->y += cm_80452C68.translation.y;
+    *fov = cm_80452C68.transform_copy.fov;
+}
